    "preset.rule.ebay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "13.6% up to $7,500, 2.35% above. Add $0.30 at $10 or less, $0.40 above. Base includes item, buyer shipping and applicable tax or handling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首 $7,500 按 13.6%，超额按 2.35%。订单总额不超过 $10 加 $0.30，超过加 $0.40。基数含商品价、买家运费及适用税费和处理费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首 $7,500 按 13.6%，超額按 2.35%。訂單總額不超過 $10 加 $0.30，超過加 $0.40。基礎含商品價、買家運費及適用稅費與處理費。"
          }
        }
      }
    },
    "preset.rule.vinted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "$0 standard seller fee. Buyer protection is charged to the buyer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准卖家手续费 $0。买家保障费由买家承担。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一般賣家手續費 $0。買家保障費由買家負擔。"
          }
        }
      }
    },
    "preset.rule.poshmark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "$2.95 below $15, 20% at $15 or more. Add seller-funded shipping discounts to shipping."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商品价低于 $15 收 $2.95，$15 起收 20%。卖家承担的运费折扣计入运费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "商品價低於 $15 收 $2.95，$15 起收 20%。賣家負擔的運費折扣計入運費。"
          }
        }
      }
    },
    "preset.rule.xianyu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference rate 0.6% of the amount including buyer shipping, capped at ¥60. Check your bill for special fees."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考成交额含买家运费的 0.6%，每笔封顶 ¥60。特殊类目或账户按账单填写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參考成交額含買家運費的 0.6%，每筆上限 ¥60。特殊類別或帳戶依帳單填寫。"
          }
        }
      }
    },
